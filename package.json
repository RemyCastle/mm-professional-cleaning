{
  "name": "mm-professional-cleaning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "chrome": "python3 scripts/crop-logo.py",
    "pages:dev": "npm run build && wrangler pages dev ./out",
